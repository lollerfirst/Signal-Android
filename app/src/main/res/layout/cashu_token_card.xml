<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cashu_token_card"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="@color/signal_colorSurfaceVariant"
    app:cardCornerRadius="12dp"
    app:cardUseCompatPadding="false"
    app:cardElevation="0dp">

    <LinearLayout
        android:id="@+id/cashu_token_root"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/cashu_token_btc_symbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u20BF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingEnd="8dp"
            android:textColor="@color/signal_text_primary" />

        <LinearLayout
            android:id="@+id/cashu_token_texts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/cashu_token_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Signal.Body2"
                android:textStyle="bold"
                android:textColor="@color/signal_text_primary"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="10,000,000,000 sat" />

            <TextView
                android:id="@+id/cashu_token_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Signal.Caption"
                android:textColor="@color/signal_text_secondary"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="Cashu token" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/cashu_token_receive_container"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:minWidth="36dp"
            android:minHeight="36dp">

            <ImageView
                android:id="@+id/cashu_token_receive_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cashu_token_receive"
                android:src="@drawable/symbol_arrow_down_tint_24"
                android:scaleType="center"
                android:visibility="visible" />

            <ProgressBar
                android:id="@+id/cashu_token_receive_spinner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="true"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
